# ==============================================================================
# COMPLEX ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env
# Then run: make n-shell or make setup-vm
# ==============================================================================

# Virtual Machine resources
VM_NAME=dev-box
VM_CPUS=2
VM_MEM=2G
VM_DISK=15G

# Runtime versions (set empty to disable)
PHP_VER=php82
NODE_VER=nodejs_18

# Active databases (space-separated)
# Options: redis, postgres, mariadb, sqlite
DATABASES=redis sqlite
