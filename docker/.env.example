# ==============================================================================
# DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize:
#   cp .env.example .env
# Then run: make build && make up
# ==============================================================================

# Container name
CONTAINER_NAME=dev-app

# Runtime versions (set empty to disable)
PHP_VER=8.2
NODE_VER=18

# Active databases (space-separated)
# Options: redis, postgres, mariadb
DATABASES=redis
